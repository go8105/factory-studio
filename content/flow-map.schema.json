{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "nodes", "edges"],
  "properties": {
    "version": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "module", "kind", "helpKey"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z_]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "enum": [
              "hr",
              "mes",
              "erp",
              "fems",
              "qms",
              "wms",
              "bems",
              "spc",
              "scm",
              "gw"
            ]
          },
          "kind": {
            "enum": ["solution", "card"]
          },
          "helpKey": {
            "type": ["string", "null"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "solution"
                }
              }
            },
            "then": {
              "properties": {
                "module": {
                  "enum": [
                    "hr",
                    "mes",
                    "erp",
                    "fems",
                    "qms",
                    "wms",
                    "bems",
                    "spc",
                    "gw"
                  ]
                },
                "helpKey": {
                  "type": "string",
                  "pattern": "^(hr/h|mes/m|erp/e|fems/f|qms/q|wms/w|bems/b|spc/s|gw/g)-[0-9]{2}$"
                }
              }
            },
            "else": {
              "properties": {
                "module": {
                  "enum": ["scm"]
                },
                "helpKey": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "label", "kind"],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["solution", "card"]
          }
        }
      }
    }
  }
}
