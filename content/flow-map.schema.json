{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "module",
          "kind",
          "helpKey"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z_]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "enum": [
              "mes",
              "erp",
              "fems",
              "qms",
              "wms",
              "bems",
              "scm"
            ]
          },
          "kind": {
            "enum": [
              "solution",
              "card"
            ]
          },
          "helpKey": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "solution"
                }
              }
            },
            "then": {
              "properties": {
                "module": {
                  "enum": [
                    "mes",
                    "erp",
                    "fems",
                    "qms",
                    "wms"
                  ]
                },
                "helpKey": {
                  "type": "string",
                  "pattern": "^(mes/m|erp/e|fems/f|qms/q|wms/w)-[0-9]{2}$"
                }
              }
            },
            "else": {
              "properties": {
                "module": {
                  "enum": [
                    "bems",
                    "scm"
                  ]
                },
                "helpKey": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "label",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "solution",
              "card"
            ]
          }
        }
      }
    }
  }
}
