{
  "name": "factory-studio-cad-cam-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5241 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5241 --strictPort",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src tests tools *.html vite.config.js package.json README.md",
    "format:check": "prettier --check src tests tools *.html vite.config.js package.json README.md",
    "poc:build": "node tools/build-soap-poc.mjs",
    "poc:flex": "node tools/build-soap-flex.mjs",
    "cnc:experiment": "node experiments/cnc-offset-e0.mjs"
  },
  "dependencies": {
    "polygon-clipping": "0.15.7",
    "three": "0.186.1",
    "manifold-3d": "3.5.4"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
